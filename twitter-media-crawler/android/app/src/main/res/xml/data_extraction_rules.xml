<?xml version="1.0" encoding="utf-8"?>
<!-- X 로그인 쿠키·받은 기록이 클라우드 백업이나 기기 간 이전으로 다른 곳에 복사되지 않도록 전부 제외한다 -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
